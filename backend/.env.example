# Server Configuration
PORT=3000

# 256-bit AES Encryption Secret Key (Minimum 32 characters or any secret string)
ENCRYPTION_KEY=emergency-response-qr-super-secure-production-key-2026

# ==============================================================================
# OPTIONAL: FIREBASE CLOUD FIRESTORE (100% FREE SPARK TIER)
# ==============================================================================
# If left blank, the app runs completely on the local zero-config persistent JSON engine.
# To connect Firebase for free (No Credit Card required):
#
# Option A (Simplest): Place your downloaded "serviceAccountKey.json" inside the backend/ folder.
#
# Option B (For Cloud Deployment e.g. Render/Railway): Paste your JSON or Base64 string here:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
#
# Option C (Individual Variables):
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ==============================================================================
# OPTIONAL: TWILIO EMERGENCY SMS DISPATCH
# ==============================================================================
# Leave commented out for built-in interactive simulator mode
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+15005550006
